# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: テンプレートだけはコミットする
!.env.example

# git worktree（並列開発用の作業ツリー）
/.worktrees/

# 講座提供の教材（再配布しない。配置方法は data/README.md）
/data/pdfs/*.pdf
/data/eval/raw/
/data/eval/test-questions.csv
# 評価結果は教材の質問文を含むためローカルのみ（要約は README に記載）
/data/eval/results/

# Vercel 用の環境変数ファイル（秘密情報を含む。GitHub に登録しない）
/vercel.env
