# .env.local にコピーして値を入れる（.env.local は Git 管理外）
# cp .env.example .env.local

# --- Supabase（案件3専用プロジェクト / 東京リージョン） ---
# Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー・取り込みスクリプト専用。NEXT_PUBLIC_ を絶対に付けない
SUPABASE_SECRET_KEY=

# --- 認証 ---
# ログイン・登録を許可するメールドメイン（カンマ区切り、完全一致）
# 例: ALLOWED_EMAIL_DOMAINS=example.com,school.example.jp
ALLOWED_EMAIL_DOMAINS=

# --- Embedding（Voyage AI 公式で発行） ---
VOYAGE_API_KEY=
# 既定: https://api.voyageai.com/v1/embeddings（MongoDB Atlas で発行したキーの場合のみ変更）
# VOYAGE_API_URL=

# --- Claude ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- 検索チューニング（任意） ---
# RAG_MATCH_COUNT=5
# RAG_MATCH_THRESHOLD=0.5
